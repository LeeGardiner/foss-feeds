# Copy to .env and fill in. All values are optional.

# ── ntfy push alerts (https://ntfy.sh) ──────────────────────────────────
# Full topic URL. Leave unset to disable push alerts entirely.
# Treat the topic name like a password: anyone who knows it can read and post.
# NTFY_URL=https://ntfy.sh/your-secret-topic-name

# Base URL used in alert click-throughs (your reverse-proxy host).
# PUBLIC_URL=https://feeds.example.com

# ── Tuning (defaults shown) ─────────────────────────────────────────────
# PORT=3004
# REFRESH_MIN=5
# TZ=Europe/London
# RETENTION_DAYS=7
# ALERT_LEVELS=crit,warn
# ALERT_WINDOW_START=09:00
# ALERT_WINDOW_END=17:30
# ALERT_EVERY_MIN=15
# SUMMARY_AT=09:00
# SUMMARY_LOOKBACK_H=16
