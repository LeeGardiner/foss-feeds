{
  "name": "foss-feeds",
  "version": "2.0.0",
  "private": true,
  "description": "A cybersecurity RSS aggregator with an old-school IRC channel UI, built as a static site by GitHub Actions.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-static.js",
    "preview": "node scripts/preview.js",
